# 데이터베이스 설정
DATABASE_URL=

# JWT 인증 설정
JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# 서버 설정
PORT=3000
FRONTEND_URL=http://localhost:3001

# Google OAuth 설정
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# 벡터 데이터베이스 설정 (선택사항 - 실패시 기본 토픽 사용)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=mindiary-index

# AI 모델 API 키 설정 (최소 1개는 필수)
# 각 모델별로 API 키를 설정하면 해당 모델이 활성화됩니다.
# 안정성 우선순위: Gemini (9) > GPT-5 (7) > Claude (6)

# Google Gemini 2.5 Flash (가장 안정적, 권장)
GEMINI_API_KEY=

# Anthropic Claude Sonnet 4 (현재는 Claude 3.5 Sonnet 사용)
CLAUDE_API_KEY=

# OpenAI GPT-5 (현재는 GPT-4o 사용, GPT-5 출시시 업데이트)
OPENAI_API_KEY=

# 환경 설정
NODE_ENV=development
