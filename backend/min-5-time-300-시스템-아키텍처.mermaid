graph TD
    Client["클라이언트 (Next.js/TypeScript)"]
    API["API 서버 (NestJS)"]
    DB["데이터베이스 (PostgreSQL)"]
    AI["OpenAI GPT-4 API"]
    Storage["파일 스토리지 (이미지/음성)"]
    Cache["캐시 서버 (Redis)"]
    
    Client -- "HTTPS 요청/응답" --> API
    API -- "SQL 쿼리" --> DB
    API -- "질문 생성 요청" --> AI
    API -- "파일 업로드/다운로드" --> Storage
    API -- "세션/캐싱" --> Cache
    
    subgraph "프론트엔드"
        Client -- "SSR/CSR" --> Pages["페이지 컴포넌트"]
        Pages --> Components["UI 컴포넌트"]
        Pages --> Hooks["커스텀 훅"]
        Pages --> Store["상태 관리"]
    end
    
    subgraph "백엔드"
        API --> Controllers["컨트롤러"]
        Controllers --> Services["서비스"]
        Services --> Repositories["리포지토리"]
        Services --> DTOs["데이터 전송 객체"]
    end
    
    subgraph "인프라"
        VPS["VPS (Virtual Private Server)"]
        NGINX["NGINX (웹 서버)"]
        PM2["PM2 (프로세스 관리자)"]
        
        VPS --> NGINX
        VPS --> PM2
        NGINX --> API
        PM2 --> API
    end