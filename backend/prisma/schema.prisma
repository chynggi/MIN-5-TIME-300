// Prisma schema for MIN-5-TIME-300
// PostgreSQL 사용

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  username         String   @unique
  mbti             String?
  bio              String?
  location         String?
  birthDate        String?
  gender           String?  // 성별 필드 추가
  profileColor     String?  // 사용자 지정 프로필 배경색 (hex or css color)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isActive         Boolean  @default(true)
  isPrivate        Boolean  @default(false) // 비공개 계정 여부
  profileImageUrl  String?
  // 개인정보 공개 설정
  isProfilePublic      Boolean @default(true)
  showMbti            Boolean @default(true)
  showLocation        Boolean @default(true)
  showBirthDate       Boolean @default(false)
  allowFollowRequests Boolean @default(true)
  showDiariesToFriends Boolean @default(true)
  showDiariesToPublic Boolean @default(false)
  // 라이프스타일 정보
  workStyle           String?
  exerciseFrequency   String?
  sleepPattern        String?
  socialActivity      String?
  // 활동지수(0~100) 및 등급(1~12) 저장. activityScore는 퍼센트 단위 값
  // 요구사항 변경: 가입 시 기본값 100% 부여
  activityScore       Float    @default(100)
  activityLevel       Int      @default(1)
  lastActivityDecayAt DateTime?
  interests        UserInterest[]
  lifestyleAnswers LifestyleAnswer[]
  journals         Journal[]
  recordScores     RecordScore[]
  // 체크인/베이스라인/한마디
  checkins         DailyCheckin[]
  baselineCheckin  UserBaselineCheckin?
  advices          Advice[]
  adviceFeedbacks  AdviceFeedback[]
  sentMessages     ChatMessage[]    @relation("SentMessages")
  messageDeliveries MessageDelivery[] @relation("MessageDeliveries")
  conversationParticipants ConversationParticipant[]
  friendsRequested Friend[]         @relation("FriendsRequested")
  friendsReceived  Friend[]         @relation("FriendsReceived")
  // (Removed) communityComments CommunityComment[]
  journalReactions JournalReaction[]
  notificationSettings NotificationSettings?
  persona          UserPersona?
  // (Removed) feedbackLogs FeedbackLog[]
  privacySettings PrivacySettings?
  blockedUsers    UserBlock[]      @relation("BlockedUsers")
  blockedByUsers  UserBlock[]      @relation("BlockedByUsers")
  // 팔로우 관계
  followers       Follow[]         @relation("Followers")  // 나를 팔로우하는 사람들
  following       Follow[]         @relation("Following")  // 내가 팔로우하는 사람들
  followCounters  FollowCounters?
  // 알림 관련 관계
  notificationPrefs     NotificationPrefs?
  notifications         Notification[]
  notificationCounter   NotificationCounter?
  deviceTokens          DeviceToken[]
  // 활동지수 공개 및 초기화 정보
  activityPublic    Boolean  @default(true)
  activityResetAt   DateTime?
  // 스트릭/배지
  streakDays        Int      @default(0)
  badges            Badge[]
}


model UserPersona {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  persona   String
  goals     String   // JSON 문자열(목표 배열)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model UserInterest {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  interest  String
  priority  Int
  createdAt DateTime @default(now())
}

model LifestyleAnswer {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Journal {
  id              String            @id @default(uuid())
  user            User              @relation(fields: [userId], references: [id])
  userId          String
  title           String?           // 일기 제목 (사용자 입력)
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  diaryDate       DateTime @default(now()) // 일기 작성 날짜 (사용자가 지정, 기본값은 현재 시각)
  isRetrospective Boolean  @default(false) // 과거 날짜 회고 작성 여부
  isPublic        Boolean  @default(false)
  emotionScore    Int
  emotion         String?           // 감정 이모지 저장
  mediaUrl        String?
  mediaType       String?
  writingDuration Int
  reactions       JournalReaction[] // 좋아요 저장 모델과 연결
  // (Removed) communityComments CommunityComment[]
  // (Removed) feedbackLogs FeedbackLog[]
  lat        Float?   // 위도
  lng        Float?   // 경도
  embedding   Float[]  // 임베딩(768차원) 저장: 재계산 비용 절감
  // 요약 메타데이터 (2025-09 추가)
  summaryModel        String?  // 요약에 실제 사용된 모델명
  summaryTruncated    Boolean? @default(false) // 길이 제한으로 잘렸는지 여부
  summaryFallbackUsed Boolean? @default(false) // 폴백 사용 여부
  // 질문 기반 작성 시, 사용자가 선택한 질문들의 도메인/텍스트(옵션)
  selectedQuestionDomains String[]
  selectedQuestionTexts   String[]
  // 체크인 연결 (옵션)
  checkin       DailyCheckin?
}


model JournalReaction {
  id           String   @id @default(uuid())
  journal      Journal  @relation(fields: [journalId], references: [id])
  journalId    String
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  // User.journalReactions와 연결
  reactionType String
  createdAt    DateTime @default(now())

  @@unique([journalId, userId, reactionType])
}

model RecordScore {
  id                String   @id @default(uuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            String
  consistencyScore  Int
  emotionVariance   Int
  writingQuality    Int
  periodStart       DateTime
  periodEnd         DateTime
}


model Friend {
  id           String   @id @default(uuid())
  requester    User     @relation("FriendsRequested", fields: [requesterId], references: [id])
  requesterId  String
  addressee    User     @relation("FriendsReceived", fields: [addresseeId], references: [id])
  addresseeId  String
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 1:1 채팅을 위한 대화 모델
model Conversation {
  id            String   @id @default(uuid())
  dmKey         String   @unique // 1:1 전용: "min(userId)-max(userId)" 형태로 중복 방지
  lastMessageId String?
  lastMessage   ChatMessage? @relation("ConversationLastMessage", fields: [lastMessageId], references: [id])
  participants  ConversationParticipant[]
  messages      ChatMessage[] @relation("ConversationMessages")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 대화 참여자 (1:1이므로 항상 2명)
model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadMessageId String?
  lastReadAt       DateTime?
  notificationsMuted Boolean @default(false)

  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@index([userId])
}

// 채팅 메시지
model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType  @default(text)
  content        String?
  attachments    Json?        // 첨부파일 메타데이터 JSON
  replyToId      String?      // 답장할 메시지 ID
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?    // 소프트 삭제

  // 멱등성: 같은 보낸이+키 중복 방지
  idempotencyKey String?

  conversation Conversation @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])
  deliveries   MessageDelivery[]
  lastMessageOf Conversation[] @relation("ConversationLastMessage")

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)]) // 커서 페이지네이션용
  @@index([senderId])
}

// 메시지 전달/읽음 상태
model MessageDelivery {
  messageId   String
  recipientId String
  status      MessageDeliveryStatus @default(SENT)
  deliveredAt DateTime?
  readAt      DateTime?

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient User        @relation("MessageDeliveries", fields: [recipientId], references: [id])

  @@id([messageId, recipientId])
  @@index([recipientId, status])
}

// 메시지 타입 enum
enum MessageType {
  text
  image
  file
  audio
  video
  system
}

// 전달 상태 enum (기존 DeliveryStatus와 구분)
enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
}



model NotificationSettings {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  email                     Boolean  @default(true)
  push                      Boolean  @default(true)
  sms                       Boolean  @default(false)
  reminderEnabled           Boolean  @default(true)
  reminderTime              String?
  friendRequestNotification Boolean  @default(true)
  commentNotification       Boolean  @default(true)
  reactionNotification      Boolean  @default(true)
  messageNotification       Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model PrivacySettings {
  id                      String   @id @default(uuid())
  user                    User     @relation(fields: [userId], references: [id])
  userId                  String   @unique
  profileVisibility       String   @default("FRIENDS")    // PUBLIC, FRIENDS, PRIVATE
  mbtiVisibility          String   @default("FRIENDS")
  locationVisibility      String   @default("FRIENDS")
  birthDateVisibility     String   @default("PRIVATE")
  interestsVisibility     String   @default("FRIENDS")
  lifestyleVisibility     String   @default("FRIENDS")
  diaryDefaultVisibility  String   @default("PRIVATE")
  followersVisibility     String   @default("PUBLIC")     // PUBLIC, FRIENDS, PRIVATE
  followingVisibility     String   @default("PUBLIC")     // PUBLIC, FRIENDS, PRIVATE
  allowFollowRequests     Boolean  @default(true)
  showOnlineStatus        Boolean  @default(true)
  allowDirectMessages     Boolean  @default(true)
  showInRecommendations   Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model UserBlock {
  id          String   @id @default(uuid())
  blocker     User     @relation("BlockedUsers", fields: [blockerId], references: [id])
  blockerId   String
  blocked     User     @relation("BlockedByUsers", fields: [blockedId], references: [id])
  blockedId   String
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// 팔로우 관계 테이블
model Follow {
  id           String   @id @default(uuid())
  follower     User     @relation("Following", fields: [followerId], references: [id])
  followerId   String
  followee     User     @relation("Followers", fields: [followeeId], references: [id])
  followeeId   String
  status       FollowStatus @default(ACTIVE)
  isFavorite   Boolean  @default(false)
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  @@unique([followerId, followeeId])
  @@index([followeeId, createdAt])  // followers 조회용
  @@index([followerId, createdAt])  // following 조회용
  @@index([followerId, status, isFavorite])  // 탭별 조회용
}

// 팔로우 카운터 캐시
model FollowCounters {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String   @unique
  followersCount  Int      @default(0)
  followingCount  Int      @default(0)
  updatedAt       DateTime @default(now()) @updatedAt
}

enum FollowStatus {
  ACTIVE
  REQUESTED
}

// 알림 설정 - 채널별/유형별 on/off
model NotificationPrefs {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @unique
  // 채널별 설정
  channelPush         Boolean  @default(true)
  channelInApp        Boolean  @default(true)
  channelEmail        Boolean  @default(false)
  // 조용 시간 설정 (JSON: {tz:"Asia/Seoul", from:"23:00", to:"08:00"})
  quietHours          Json?
  // 알림 유형별 설정 (JSON: {follow:true, like:true, comment:true, mention:true})
  types               Json     @default("{\"follow\":true,\"like\":true,\"comment\":true,\"mention\":true,\"diary\":true}")
  lang                String   @default("ko-KR")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// 알림 본문 템플릿 (국제화/채널별)
model NotificationTemplate {
  id         String   @id @default(uuid())
  type       String   // 예: 'follow_requested', 'post_liked'
  channel    String   // 'inapp', 'push', 'email'
  locale     String   // 'ko-KR', 'en-US'
  titleTpl   String   // 예: "{{actor_name}}님이 회원님을 팔로우하기 요청했어요"
  bodyTpl    String?  // 예: "{{actor_name}} 외 {{extra_count}}명이 회원님의 글을 좋아합니다"
  deepLink   String?  // 예: "myapp://post/{{object_id}}"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([type, channel, locale])
}

// 알림 인박스 (사용자별 저장되는 실제 알림)
model Notification {
  id           String   @id @default(uuid())
  recipient    User     @relation(fields: [recipientId], references: [id])
  recipientId  String
  type         String   // 'follow_requested', 'post_liked', 'post_commented' 등
  actorIds     Json     // 집계형: 여러 주체를 담기 위함 (최신이 앞)
  objectType   String?  // 'user', 'journal', 'comment' 등
  objectId     String?
  groupKey     String?  // 집계 기준 키 (예: "post_liked:JOURNAL_ID")
  groupCount   Int      @default(1)
  payload      Json?    // 렌더링에 필요한 가변 정보
  status       NotificationStatus @default(UNREAD)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  expiresAt    DateTime?
  deliveries   NotificationDelivery[]

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId, status])
}

// 채널별 실제 발송 기록
model NotificationDelivery {
  id               String   @id @default(uuid())
  notification     Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId   String
  channel          String   // 'push', 'email'
  providerMsgId    String?
  status           DeliveryStatus @default(PENDING)
  attempts         Int      @default(0)
  lastAttemptAt    DateTime?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 뱃지/카운트 캐시
model NotificationCounter {
  id                 String   @id @default(uuid())
  user               User     @relation(fields: [userId], references: [id])
  userId             String   @unique
  unreadCount        Int      @default(0)
  lastCalculatedAt   DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// 푸시용 디바이스 토큰
model DeviceToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String
  platform  String   // 'ios', 'android', 'web'
  isActive  Boolean  @default(true)
  locale    String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
}

// Outbox: 도메인 이벤트 → 알림 빌더로 전달
model OutboxEvent {
  id          String   @id @default(uuid())
  eventKey    String   @unique  // 멱등성 키
  type        String   // 예: 'follow_requested'
  actorId     String
  objectType  String?
  objectId    String?
  payload     Json?
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@index([processedAt])
}

// 배지/업적
model Badge {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String   // 예: 'streak_3', 'streak_7', 'streak_30'
  awardedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
}

enum NotificationStatus {
  UNREAD
  READ
  HIDDEN
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  THROTTLED
  SKIPPED
}

// ==========================
// Check-in & Advice Feature
// ==========================

// 하루 체크인(일기/날짜 1:1)
model DailyCheckin {
  id                    String   @id @default(uuid())
  user                  User     @relation(fields: [userId], references: [id])
  userId                String
  journal               Journal? @relation(fields: [journalId], references: [id], onDelete: SetNull)
  journalId             String?
  diaryDate             DateTime @default(now())
  // 1~10 고정 (앱 단/서버 단 검증)
  mood_1to10            Int
  energy_1to10          Int
  stress_1to10          Int
  // 수면 시간: 1~9 (9=9시간 이상)
  sleep_hours_1to9p     Int
  sleep_quality_1to10   Int
  // 활동: ["운동","명상","스트레칭","산책"] 중 0~N개
  activity_types        String[]
  // 운동 포함 시 1~10, 아니면 0
  workout_intensity_1to10 Int @default(0)
  focus_1to10           Int
  fatigue_1to10         Int
  social_count_1to10    Int
  social_satisfaction_1to10 Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, diaryDate])
  @@unique([journalId])
  @@index([userId, diaryDate])
}

// 회원가입 시 최초 베이스라인(1:1)
model UserBaselineCheckin {
  id                      String   @id @default(uuid())
  user                    User     @relation(fields: [userId], references: [id])
  userId                  String   @unique
  mood_1to10              Int
  energy_1to10            Int
  stress_1to10            Int
  sleep_hours_1to9p       Int
  sleep_quality_1to10     Int
  activity_types          String[]
  workout_intensity_1to10 Int @default(0)
  focus_1to10             Int
  fatigue_1to10           Int
  social_count_1to10      Int
  social_satisfaction_1to10 Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// 오늘의 한마디 저장
model Advice {
  id        String          @id @default(uuid())
  user      User            @relation(fields: [userId], references: [id])
  userId    String
  advice    String
  tags      String[]
  risk      AdviceRiskFlag  @default(NONE)
  createdAt DateTime        @default(now())
  // feedback relation
  feedbacks AdviceFeedback[]

  @@index([userId, createdAt])
}

model AdviceFeedback {
  id         String   @id @default(uuid())
  advice     Advice   @relation(fields: [adviceId], references: [id], onDelete: Cascade)
  adviceId   String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  isHelpful  Boolean
  createdAt  DateTime @default(now())

  @@unique([adviceId, userId])
  @@index([userId, createdAt])
}

enum AdviceRiskFlag {
  NONE
  MILD
  MODERATE
  SEVERE
}
