generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  username         String    @unique
  email            String?   @unique
  googleId         String?   @unique
  password         String?
  profileImage     String?
  mbti             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  loginAttempts    Int       @default(0)
  lastLoginAttempt DateTime?
  provider         String?   @default("local")
  interests        String[]  @default([])

  // 관계 정의
  questions        Question[]
  communityEntries CommunityEntry[]
  comments         Comment[]
  likes            Like[]
  recommendations  Recommendation[]
  diaries          Diary[] // 추가된 역방향 관계
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model Question {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  authorId  String
  category  Int
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])
}

model CommunityEntry {
  id        Int      @id @default(autoincrement())
  userId    String
  prompt    String
  content   String   @db.Text
  emotion   String
  isPublic  Boolean  @default(true)
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  comments Comment[]
  likedBy  Like[]

  @@map("community_entries")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  userId    String
  entryId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id])
  entry CommunityEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Like {
  userId    String
  entryId   Int
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id])
  entry CommunityEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([userId, entryId])
  @@map("likes")
}

model Recommendation {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  score     Float
  type      String?
  isSeen    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
}

model Diary {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  userId    String // User의 id와 타입 일치
  isPrivate Boolean  @default(false)
  mood      String? // 추가 필요
  weather   String? // 추가 필요
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id])
  tags DiaryTag[]
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique

  diaries DiaryTag[]
}

model DiaryTag {
  id      Int @id @default(autoincrement())
  diaryId Int
  tagId   Int

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id])

  @@unique([diaryId, tagId])
}

model Admin {
  id               String    @id @default(uuid())
  username         String    @unique
  email            String    @unique
  password         String
  role             String    @default("admin") // 'admin', 'superadmin' 등 역할 구분
  name             String?
  profileImage     String?
  isActive         Boolean   @default(true)
  loginAttempts    Int       @default(0)
  lastLoginAttempt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id])
}
